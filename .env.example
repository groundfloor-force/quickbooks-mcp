QUICKBOOKS_CLIENT_ID=your_client_id_here
QUICKBOOKS_CLIENT_SECRET=your_client_secret_here
QUICKBOOKS_REFRESH_TOKEN=your_refresh_token_here
QUICKBOOKS_REALM_ID=your_company_id_here
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/callback
QUICKBOOKS_ENVIRONMENT=sandbox

# Optional: QUICKBOOKS_TOKEN_STORE_PATH — absolute path used BOTH to read config
# at startup and to persist rotated refresh tokens (defaults to this .env file).
# NOTE: it cannot be set in this file — the server resolves it BEFORE reading
# .env. Set it in the host process env instead (e.g. the "env" block of your
# MCP server config). See README "Read-only or containerized installs".

# Restriction Mode — omit or set to false to register all tools (default: all tools registered)
# QUICKBOOKS_DISABLE_WRITE=true    # suppress create_* and create-* tools
# QUICKBOOKS_DISABLE_UPDATE=true   # suppress update_* and update-* tools
# QUICKBOOKS_DISABLE_DELETE=true   # suppress delete_* and delete-* tools

# ── Remote HTTP server auth (src/http.ts only; the stdio server ignores these) ──
# All are REQUIRED by `npm run start:http` and are validated at startup.
# Set them as real environment variables (e.g. Railway service variables) —
# never commit real values to this or any other file.
#
# Public origin of the deployed server; used for the OAuth issuer and all
# absolute URLs. No trailing slash, no query or fragment. Must be https
# unless it is localhost/127.0.0.1.
# PUBLIC_URL=https://your-service.up.railway.app
#
# Google OAuth web client. Add "<PUBLIC_URL>/auth/google/callback" as an
# authorized redirect URI in the Google Cloud console.
# GOOGLE_CLIENT_ID=your_google_client_id_here
# GOOGLE_CLIENT_SECRET=your_google_client_secret_here
#
# Comma-separated list of the Google addresses allowed to sign in. Matching is
# case-insensitive and exact — no domain wildcards. Everyone on the list gets
# the identical full tool set.
# ALLOWED_EMAILS=someone@example.com,someone.else@example.com
#
# HS256 signing key for the access tokens this server issues. At least 32
# characters; generate with: openssl rand -hex 32
# SESSION_SECRET=your_long_random_secret_here
#
# Optional: AUTH_STORE_PATH — file where registered OAuth clients and refresh
# tokens (as SHA-256 digests) are persisted, so a redeploy does not disconnect
# every connected client. Put it on a mounted volume. Defaults to
# auth-store.json in the QUICKBOOKS_TOKEN_STORE_PATH directory; with neither
# set it falls back to /tmp/auth-store.json (lost on redeploy) and warns.
# AUTH_STORE_PATH=/data/auth-store.json
